[Unit]
Description=isshue user authorized_keys generator
ConditionPathExists=/etc/isshue/users.yml
ConditionFileIsExecutable=/usr/bin/yq

[Service]
Type=oneshot
ExecStart=/usr/bin/yq 'map(.ssh_keys) | flatten | join("\n")' /etc/isshue/users.yml --raw-output
StandardOutput=truncate:/home/isshue/.ssh/authorized_keys
StandardError=journal
