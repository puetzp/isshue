#!/bin/sh

set -e

if [ "$1" = "remove" ]; then
    systemctl stop isshue-authorized-keys.path
    systemctl disable isshue-authorized-keys.path
fi

if [ "$1" = "purge" ]; then
    rm -rf /etc/isshue
    rm -rf /var/lib/isshue

    systemctl stop isshue-authorized-keys.path
    systemctl disable isshue-authorized-keys.path
fi

